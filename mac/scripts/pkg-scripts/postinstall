#!/bin/bash
# Start the guard (as root) and the menu-bar app (as you).
chown root:wheel /Library/PrivilegedHelperTools/com.calm.calmd \
    /Library/LaunchDaemons/com.calm.calmd.plist /Library/LaunchAgents/com.calm.bar.plist
chmod 755 /Library/PrivilegedHelperTools/com.calm.calmd
chmod 644 /Library/LaunchDaemons/com.calm.calmd.plist /Library/LaunchAgents/com.calm.bar.plist

launchctl bootstrap system /Library/LaunchDaemons/com.calm.calmd.plist 2>/dev/null \
    || launchctl kickstart -k system/com.calm.calmd

RELOAD="/Library/Application Support/Calm/reload-bar.sh"
uid=$(stat -f %u /dev/console)
if [ -e "/Library/Application Support/Calm/.self-update" ]; then
    # The leaf menu's "Update" is waiting for this install to finish, so re-register the menu-bar app
    # a few seconds later from a separate job that doesn't stop when the old app does.
    launchctl remove com.calm.bar-reload 2>/dev/null || true
    launchctl submit -l com.calm.bar-reload -- /bin/sh "$RELOAD" "$uid" 4
else
    /bin/sh "$RELOAD" "$uid" 0
fi
exit 0
