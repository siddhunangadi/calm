<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.calm.bar</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/CalmBar.app/Contents/MacOS/CalmBar</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Comes back if you quit it. -->
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
