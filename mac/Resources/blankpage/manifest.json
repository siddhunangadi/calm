{
  "manifest_version": 3,
  "name": "Calm",
  "version": "1.0",
  "description": "Shows a plain black page instead of an error for sites Calm blocks.",
  "permissions": ["declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>", "file:///*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{ "resources": ["blank.html"], "matches": ["<all_urls>"] }],
  "icons": { "128": "icon.png" }
}
